# Copy this file to "backend/.env" and fill in your own values.
PORT=5000
# MongoDB connection string
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cinemahub?retryWrites=true&w=majority
MONGODB_URI=
retryWrites=true&w=majority
# random string used to sign JWT tokens
# (generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
# The Movie Database API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
